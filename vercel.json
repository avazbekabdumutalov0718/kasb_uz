{
  "crons": [
    {
      "path": "/api/tasks-weekly-cron",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/tasks-daily-cron",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/writing-topic-cron",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/speaking-topic-cron",
      "schedule": "5 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/tasks-upload",
      "destination": "/api/tasks-files"
    },
    {
      "source": "/api/tasks-download",
      "destination": "/api/tasks-files"
    }
  ]
}
